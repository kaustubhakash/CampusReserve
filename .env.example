# Next.js Application
PORT=3000
NODE_ENV=development

# MySQL 8 Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campus_reserve
MYSQL_CONNECTION_LIMIT=10

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/campus_reserve_logs
MONGODB_DB_NAME=campus_reserve_logs

# JWT Authentication Secret (for jose / auth)
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=24h
